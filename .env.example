# Administrator API key for registering approved tasks
ADMIN_API_KEY=change-me-admin-secret-key

# Agent API key for requesting single-use leases
AGENT_API_KEY=change-me-agent-secret-key

# Bound agent identity for the configured agent key
AGENT_ID=agent-default

# Policy authorization boundaries
ALLOWED_S3_BUCKET=agentcap-demo
ALLOWED_S3_PREFIX=reports/

# Optional: how long an admin approval stays valid, in seconds (default 900 = 15 min)
# TASK_TTL_SECONDS=900

# Optional: Path to SQLite database (defaults to broker/agentcap.db)
# DATABASE_PATH=broker/agentcap.db
